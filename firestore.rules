rules_version = '2';

// إعدادات أمان Firestore الخاصة بتطبيق "خصومات".
// حط الكود ده في Firebase Console -> Firestore Database -> Rules، أو انشره بـ:
//   firebase deploy --only firestore:rules
//
// ============================================================================
// ملحوظة مهمة جدًا قبل النشر - اقرأها الأول:
// ============================================================================
// التطبيق ده بيشتغل بنظامين مختلفين للصلاحيات في نفس الوقت:
//   1) الأدمن: بيسجّل دخول حقيقي بإيميل وباسورد (Firebase Authentication).
//   2) صاحب المحل/العرض: معندوش حساب Firebase Auth خالص. هو بس شايل "كود"
//      نصي (زي ABC123) محفوظ في متصفحه، ولما يحب يعدّل أو يحذف عرضه، التطبيق
//      بيقارن كود العرض بالكود المحفوظ عنده (canManageItem في الجافاسكريبت).
//
// المشكلة: قواعد Firestore بتشتغل على السيرفر ومش عندها أي طريقة تتأكد إن
// "الكود" اللي باعته المتصفح ده فعلاً بتاع صاحب المحل الحقيقي، لأن مفيش تسجيل
// دخول حقيقي وراه. أي حد فاتح "أدوات المطوّر" في المتصفح يقدر يبعت أي كود يحبه.
// يعني مفيش طريقة آمنة نسيب بيها "صاحب المحل" يعدّل/يحذف عرضه من غير ما يبقى
// عنده حساب Firebase Auth حقيقي (حتى لو Anonymous Auth) مربوط بالعرض ده.
//
// عشان كده القواعد تحت بتنفّذ اللي طلبته بالظبط (حذف/تعديل المنتجات role=='admin'
// بس، ومنع أي حد مش مسجّل من التعديل/الحذف عمومًا)، لكن ده معناه عمليًا:
//   - زرار "حذف/تعديل العرض" اللي بيظهر لصاحب المحل (مش الأدمن) في الواجهة
//     هيفضل ظاهر، لكن Firestore هيرفض الطلب فعليًا (permission-denied) لأنه
//     مش مسجّل دخول كأدمن. يعني عمليًا لازم كل تعديل/حذف لعرض يعدّي على الأدمن.
//   - لو عايز صاحب المحل يقدر يعدّل/يحذف عرضه بنفسه بشكل آمن فعلاً، الحل
//     الصحيح طويل المدى: تسجيل دخول Anonymous Auth لكل صاحب محل + حفظ الـ
//     uid بتاعه جوه العرض نفسه وقت الإنشاء، وبعدين تتعدل القاعدة تسمح كمان لو
//     resource.data.ownerUid == request.auth.uid. سيبلي اعرف لو عايز أعملها.
//
// أما "إنشاء" عرض جديد (نشر عرض لأول مرة) فسايبه مفتوح زي ما هو دلوقتي، لأنك
// طلبت تقييد "حذف أو تعديل" بس، وتقييد الإنشاء كان هيمنع صاحب أي محل من نشر
// أي عرض من غير ما يبقى عنده حساب أدمن - وده هيكسر وظيفة التطبيق الأساسية.
//
// باقي أنواع المستندات في kv_store (طلبات كود جديد، طلبات إعلان، شكاوى...)
// ============================================================================
// تحديث أمان: تسجيل الدخول المجهول (Anonymous) بقى تلقائي لكل زائر فور فتح
// التطبيق، وده معناه إن isSignedIn() بقت صحيحة تقريبًا لأي حد بيفتح الموقع -
// مش بس للأدمن. عشان كده الاعتماد على isSignedIn() بس في "تعديل/حذف" طلبات
// زي (complaint, ad_request, priority_request, code_request, edit_shop_request,
// code_retrieval_request, reactivation_request, delete_log) كان بيسمح لأي
// زائر عادي - من غير أي صلاحية أدمن حقيقية - إنه يحذف أو يعدّل طلبات مقدَّمة
// من ناس تانية قبل ما الأدمن حتى يشوفها، عن طريق النداء على Firestore مباشرة
// من الكونسول. اتصلّحت دلوقتي: "الإنشاء" (تقديم طلب/شكوى جديدة) لسه مفتوح
// لأي زائر زي ما هو (ده أساس عمل الميزة دي)، لكن "الموافقة/الرفض" الفعلية
// (تعديل أو حذف الطلب) بقت محصورة على الأدمن الحقيقي بس (isAdmin) عن طريق
// دالة isAdminReviewedDoc تحت.
//
// بعض المستندات التانية (code:, priorityShops, priority_grant_notice:,
// item_edit_notice:, delivered_code:, retrieval_approved:) هي أصلاً مش
// بتتعمل غير من لوحة تحكم الأدمن (مفيش أي واجهة تنشئها من غير أدمن)، فاتقيّدت
// بـ isAdmin() بالكامل - ما عدا حالة استثنائية واحدة موضّحة تحت.
//
// أما مستندات code: (بيانات المنشأة نفسها زي الفروع والمواعيد)، فلسه لازم
// تفضل مفتوحة لـ isSignedIn() في التعديل، لأن صاحب المحل بيعدّلها بنفسه
// مباشرة (زي إضافة فرع جديد) من غير ما يمر على أي موافقة أدمن، وقيمة
// المستند بالكامل مخزّنة كنص JSON واحد (حقل v) فمفيش طريقة في القواعد
// نفرّق بيها بين "إضافة فرع" (مسموح لصاحب المحل) و"حظر/حذف الكود نهائيًا"
// (المفروض أدمن بس) بدون تسجيل دخول حقيقي مربوط بكل كود - ده تحسين تاني
// أكبر (مطلوب فيه تعديل في الجافاسكريبت برضه) لو حبيت نعمله بعدين.

service cloud.firestore {
  match /databases/{database}/documents {

    // هل الطلب جاي من حساب مسجّل دخول فعلاً (مش زائر عادي)؟
    function isSignedIn() {
      return request.auth != null;
    }

    // هل الحساب المسجّل ده رتبته "admin" فعلاً؟ بنتأكد من مستند مخصص لكل
    // حساب في كوليكشن admins بدل ما نفترض إن أي حساب مسجّل = أدمن تلقائيًا.
    // لازم تعمل يدويًا من Firebase Console -> Firestore Database:
    //   Collection: admins   Document ID: <UID بتاع حساب الأدمن من Authentication>
    //   Field: role (string) = admin
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function isItemDoc(docId) {
      return docId.matches('^item:.*');
    }

    // صاحب العرض الحقيقي: بقى كل زائر (حتى العادي) بيتسجل دخول Anonymous
    // تلقائيًا من التطبيق، فبقى ممكن نتحقق فعليًا إن اللي بيعدّل/يحذف العرض
    // هو نفس اللي نشره، عن طريق حقل ownerUid (حقل Firestore حقيقي top-level،
    // مش جوه أي نص متسلسل) المتخزّن وقت إنشاء العرض لأول مرة.
    function isItemOwner() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // مفاتيح إعدادات عامة حساسة يتحكم فيها الأدمن بس (تشغيل/إيقاف عدادات
    // المتابعين والحفظ والمشاهدات للجميع).
    function isProtectedSetting(docId) {
      return docId == 'showEngagementCounts' || docId == 'showViewCounts';
    }

    // طلبات بيقدّمها أي زائر عادي (شكوى، طلب كود جديد، طلب إعلان، طلب أولوية،
    // طلب تعديل بيانات منشأة، طلب استلام كود، طلب إعادة تفعيل)، والأدمن بس
    // هو اللي يقدر "يوافق" عليها (تعديل) أو "يرفضها" (حذف). الإنشاء لسه
    // مفتوح للجميع لأنه أساس الميزة، لكن أي تعديل أو حذف بعد كده أدمن فقط.
    function isAdminReviewedDoc(docId) {
      return docId.matches('^complaint:.*')
        || docId.matches('^ad_request:.*')
        || docId.matches('^priority_request:.*')
        || docId.matches('^code_request:.*')
        || docId.matches('^edit_shop_request:.*')
        || docId.matches('^code_retrieval_request:.*')
        || docId.matches('^reactivation_request:.*')
        || docId.matches('^delete_log:.*');
    }

    // مستندات بينشئها الأدمن بس من الأساس (إشعارات/تسجيلات داخلية ناتجة عن
    // أفعال أدمن حقيقية زي منح أولوية أو تسليم كود) - مفيش أي واجهة في
    // التطبيق تسمح لزائر عادي ينشئها أو يعدّلها.
    function isAdminOnlyDoc(docId) {
      return docId == 'priorityShops'
        || docId.matches('^priority_grant_notice:.*')
        || docId.matches('^item_edit_notice:.*')
        || docId.matches('^delivered_code:.*');
    }

    // موافقة الأدمن على "استلام كود" برقم هاتف: الأدمن بس يقدر يمنحها
    // (إنشاء/تعديل)، لكن صاحب الرقم نفسه هو اللي "بيستهلكها" (حذف) لحظة ما
    // ياخد الكود، وده مش أدمن غالبًا - فالحذف لازم يفضل متاح لأي زائر مسجّل.
    function isRetrievalApprovalDoc(docId) {
      return docId.matches('^retrieval_approved:.*');
    }

    // بيانات المنشأة (الكود نفسه). القيمة كلها متخزّنة كنص JSON واحد (زي
    // الفروع والمواعيد ورقم الهاتف وحالة التفعيل مع بعض)، فمفيش طريقة في
    // القواعد نفرّق بين "إضافة فرع" و"إيقاف الكود" - كلاهما عمليًا نفس نوع
    // العملية (update) على نفس الحقل. عشان كده اخترنا حل وسط عملي بدل قفل
    // كل حاجة على الأدمن (ده كان هيمنع صاحب المحل من التعديل بنفسه من أي
    // جهاز، اللي هو سلوك التطبيق الأساسي):
    //   - "تعديل" (update) لسه مفتوح لأي زائر مسجّل يعرف الكود بالظبط (زي ما
    //     كان التطبيق شغال بيه دايمًا) - لازم تفضل واعي إن الكود ده لازم
    //     يفضل سرّي زي كلمة السر، ولو اتسرّب أي حد شافه يقدر يتحكم في المنشأة
    //     بالكامل من غير ما يعدّي على أدمن.
    //   - "حذف" (delete) بقى أدمن فقط: ده أخطر عملية (فقدان نهائي للبيانات
    //     كلها)، ومحدش من واجهة التطبيق العادية بيحتاج يحذف كوده هو نفسه، فمفيش
    //     أي وظيفة هتتكسر، وده بيمنع أقل سيناريو أي حد يعرف كود يقدر يمسحه نهائيًا.
    function isCodeDoc(docId) {
      return docId.matches('^code:.*');
    }

    // مستندات الرتب نفسها: تُقرأ من أي حساب مسجّل عشان يتأكد من رتبته، لكن
    // محدش يقدر يكتب/يعدّل/يحذف منها من التطبيق - تتضاف يدويًا من الـ Console بس.
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /kv_store/{docId} {
      // القراءة عامة للجميع (كتالوج الخصومات عام لكل الزوار زي ما التطبيق مصمم)
      allow read: if true;

      // إنشاء مستند جديد:
      //  - عرض جديد (item:*) -> مفتوح لأي صاحب محل عنده كود صحيح، بشرط لو
      //    العرض بيحمل ownerUid إنه يبقى مطابق فعلاً لـ uid المستخدم الحالي
      //    (يمنع أي حد يزوّر ownerUid ويدّعي ملكية عرض بـ uid مش بتاعه)
      //  - كود جديد (code:*)                                     -> أدمن فقط
      //    (كل الأكواد الجديدة بتتولّد من لوحة الأدمن بس، مفيش زائر بينشئها بنفسه)
      //  - إعداد حساس (showEngagementCounts/showViewCounts)     -> أدمن فقط
      //  - مستند أدمن بالكامل (priorityShops, delivered_code..) -> أدمن فقط
      //  - موافقة استلام كود (retrieval_approved:*)             -> أدمن فقط (هو اللي بيمنحها)
      //  - طلب جديد (complaint, ad_request, code_request...)    -> أي زائر (ده أساس الميزة)
      //  - أي حاجة تانية (بيانات شخصية، سجل عرض...)              -> لازم تسجيل دخول على الأقل
      //    (بقى متاح تلقائيًا للجميع دلوقتي بفضل تسجيل الدخول المجهول)
      allow create: if isItemDoc(docId)
                    ? (!('ownerUid' in request.resource.data)
                       || request.resource.data.ownerUid == null
                       || (isSignedIn() && request.resource.data.ownerUid == request.auth.uid))
                    : isCodeDoc(docId)
                      ? isAdmin()
                      : (isProtectedSetting(docId) || isAdminOnlyDoc(docId) || isRetrievalApprovalDoc(docId))
                        ? isAdmin()
                        : isSignedIn();

      // تعديل مستند موجود:
      //  - عرض منشور (item:*) -> الأدمن، أو نفس صاحب العرض الحقيقي (ownerUid
      //    مطابق)، بشرط إنه ميقدرش ينقل ملكية العرض لحد تاني وهو بيعدّله
      //  - بيانات منشأة (code:*)  -> أي زائر مسجّل يعرف الكود بالظبط (زي ما
      //    كان التطبيق شغال بيه دايمًا - راجع الشرح فوق ليه القاعدة دي مش
      //    مقفولة أكتر من كده)
      //  - إعداد حساس (showEngagementCounts/showViewCounts)     -> أدمن فقط
      //  - طلب بينتظر مراجعة (complaint, ad_request, ...)       -> أدمن فقط
      //  - مستند أدمن بالكامل (priorityShops, delivered_code..) -> أدمن فقط
      //  - موافقة استلام كود (retrieval_approved:*)             -> أدمن فقط
      //  - أي حاجة تانية (بيانات شخصية، سجل عرض...)              -> لازم تسجيل دخول على الأقل
      allow update: if isItemDoc(docId)
                    ? (isAdmin() || (isItemOwner()
                        && (!('ownerUid' in request.resource.data)
                            || request.resource.data.ownerUid == resource.data.ownerUid)))
                    : (isProtectedSetting(docId) || isAdminReviewedDoc(docId)
                       || isAdminOnlyDoc(docId) || isRetrievalApprovalDoc(docId))
                      ? isAdmin()
                      : isSignedIn();

      // حذف مستند موجود:
      //  - عرض منشور (item:*) -> الأدمن، أو نفس صاحب العرض الحقيقي (ownerUid مطابق)
      //  - بيانات منشأة (code:*) -> أدمن فقط. دي أخطر عملية ممكنة (فقدان
      //    نهائي)، ومفيش أي واجهة في التطبيق العادي بتحتاج زائر يحذف كوده
      //    هو بنفسه، فتقييدها على الأدمن مبيكسرش أي وظيفة موجودة فعلاً.
      //  - طلب بينتظر مراجعة (complaint, ad_request, ...)       -> أدمن فقط
      //  - مستند أدمن بالكامل (priorityShops, delivered_code..) -> أدمن فقط
      //  - موافقة استلام كود (retrieval_approved:*)             -> أي زائر مسجّل
      //    (صاحب الرقم نفسه هو اللي بيحذفها لحظة ما ياخد كوده، مش الأدمن)
      //  - أي حاجة تانية (بيانات شخصية، سجل عرض...)              -> لازم تسجيل دخول على الأقل
      allow delete: if isItemDoc(docId)
                    ? (isAdmin() || isItemOwner())
                    : isCodeDoc(docId)
                      ? isAdmin()
                      : (isAdminReviewedDoc(docId) || isAdminOnlyDoc(docId))
                        ? isAdmin()
                        : isSignedIn();
    }
  }
}
